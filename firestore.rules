
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid in [
          'HdcKYuUZoRdr9lwths0IQzlg0t12'
        ];
    }

    match /users/{uid} {
      allow get: if isOwner(uid) || isAdmin();
      allow list: if isAdmin();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'fatherName', 'nationalId',
          'email', 'whatsapp', 'countryResidency',
          'countryStudy', 'medicalProgram', 'medicalYear',
          'graduationYear', 'courseToStudy',
          'accountStatus', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'fatherName', 'nationalId',
          'email', 'whatsapp', 'countryResidency',
          'countryStudy', 'medicalProgram', 'medicalYear',
          'graduationYear', 'courseToStudy',
          'accountStatus', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.accountStatus == 'pending_verification'
        && request.resource.data.medicalProgram in ['MBBS', 'MD']
        && request.resource.data.medicalYear in [
          '1', '2', '3', '4', '5', '6', 'Graduated'
        ]
        && request.resource.data.courseToStudy is string
        && request.resource.data.fullName is string
        && request.resource.data.fatherName is string
        && request.resource.data.nationalId is string
        && request.resource.data.whatsapp is string
        && request.resource.data.countryResidency is string
        && request.resource.data.countryStudy is string
        && request.resource.data.createdAt == request.time;

      allow update, delete: if isAdmin();
    }

    match /memberships/{id} {
      allow read, write: if isAdmin();
    }

    match /courses/{id} {
      allow read, write: if isAdmin();
    }

    match /exams/{id} {
      allow read, write: if isAdmin();
    }

    match /demoContent/{id} {
      allow read, write: if isAdmin();
    }

    match /invoices/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
